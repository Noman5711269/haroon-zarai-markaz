# ========================================================
# ہارون زرعی مرکز (HAROON ZARAI MARKAZ)
# انوائرنمنٹ کنفیگریشن فائل (Environment Variables)
# ========================================================

# پورٹ نمبر (Local Development: 5000)
PORT=5000

# ایڈمن پن کوڈ (Default: 1234)
ADMIN_PIN=1234

# ========================================================
# کلاؤڈ سپابیس ڈیٹا بیس (SUPABASE CONFIGURATION)
# ========================================================
# اگر آپ سپابیس کلاؤڈ ڈیٹا بیس لگانا چاہتے ہیں:
# 1. https://supabase.com پر جا کر نیا پروجیکٹ بنائیں
# 2. Project Settings > API سے درج ذیل معلومات کاپی کریں:

# آپ کا Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# آپ کی Supabase Service Role Key یا Anon Public Key
# (Service Role Key تجویز کی جاتی ہے کیونکہ اس سے تمام ٹیبلز میں ایڈمن ڈیٹا محفوظ ہو سکتا ہے)
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# نوٹ: اگر SUPABASE_URL اور SUPABASE_KEY خالی ہوں گے تو سرور
# خودبخود لوکل فائل (data/db.json) استعمال کرے گا۔
